import 'dart:async';

import 'package:flutter/material.dart';

import '../../gab/gab_branding.dart';
import '../../widgets/quick_action_sheet.dart';
import '../accounts/journal_screen.dart';
import '../purchases/purchase_screen.dart';
import '../sales/add_sale_screen.dart';
import 'business_overview_screen.dart';

class DashboardScreen extends StatefulWidget {
  const DashboardScreen({super.key});

  @override
  State<DashboardScreen> createState() => _DashboardScreenState();
}

class _DashboardScreenState extends State<DashboardScreen> {
  Timer? _clockTimer;

  DateTime _currentTime = DateTime.now();

  String _businessName = 'My Business';

  @override
  void initState() {
    super.initState();

    _loadBusinessName();

    _clockTimer = Timer.periodic(const Duration(seconds: 1), (_) {
      if (!mounted) return;

      setState(() {
        _currentTime = DateTime.now();
      });
    });
  }

  @override
  void dispose() {
    _clockTimer?.cancel();
    super.dispose();
  }

  Future<void> _loadBusinessName() async {
    await GABBranding.refresh();

    if (!mounted) return;

    final name = GABBranding.businessName.trim();

    setState(() {
      _businessName = name.isEmpty ? 'My Business' : name;
    });
  }

  String _two(int value) {
    return value.toString().padLeft(2, '0');
  }

  String _timeText() {
    var hour = _currentTime.hour;

    final suffix = hour >= 12 ? 'PM' : 'AM';

    hour %= 12;

    if (hour == 0) {
      hour = 12;
    }

    return '${_two(hour)}:${_two(_currentTime.minute)} '
        '${_two(_currentTime.second)} $suffix';
  }

  String _weekday() {
    const values = [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday',
    ];

    return values[_currentTime.weekday - 1];
  }

  String _month() {
    const values = [
      'January',
      'February',
      'March',
      'April',
      'May',
      'June',
      'July',
      'August',
      'September',
      'October',
      'November',
      'December',
    ];

    return values[_currentTime.month - 1];
  }

  String _dateText() {
    return '${_weekday()}, '
        '${_currentTime.day} ${_month()} ${_currentTime.year}';
  }

  Future<void> _open(Widget page) async {
    await Navigator.push(context, MaterialPageRoute(builder: (_) => page));

    if (!mounted) return;

    await _loadBusinessName();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xfff5f7fb),
      body: SafeArea(
        child: LayoutBuilder(
          builder: (context, constraints) {
            final width = constraints.maxWidth;
            final isMobile = width < 700;

            if (isMobile) {
              return SingleChildScrollView(
                padding: const EdgeInsets.fromLTRB(10, 10, 10, 24),
                child: Center(
                  child: ConstrainedBox(
                    constraints: const BoxConstraints(maxWidth: 1450),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.stretch,
                      children: [
                        _buildHeader(true),
                        const SizedBox(height: 12),
                        _buildSixActionGrid(
                          mobile: true,
                          availableHeight: null,
                        ),
                      ],
                    ),
                  ),
                ),
              );
            }

            const horizontalPadding = 18.0;
            const topPadding = 10.0;
            const bottomPadding = 18.0;
            const headerHeight = 142.0;
            const gapAfterHeader = 16.0;

            final cardsHeight =
                (constraints.maxHeight -
                        topPadding -
                        bottomPadding -
                        headerHeight -
                        gapAfterHeader)
                    .clamp(390.0, 720.0)
                    .toDouble();

            return SingleChildScrollView(
              padding: const EdgeInsets.fromLTRB(
                horizontalPadding,
                topPadding,
                horizontalPadding,
                bottomPadding,
              ),
              child: Center(
                child: ConstrainedBox(
                  constraints: const BoxConstraints(maxWidth: 1450),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      SizedBox(
                        height: headerHeight,
                        child: _buildHeader(false),
                      ),
                      const SizedBox(height: gapAfterHeader),
                      _buildSixActionGrid(
                        mobile: false,
                        availableHeight: cardsHeight,
                      ),
                    ],
                  ),
                ),
              ),
            );
          },
        ),
      ),
    );
  }

  Widget _buildHeader(bool mobile) {
    return Container(
      padding: EdgeInsets.symmetric(
        horizontal: mobile ? 15 : 28,
        vertical: mobile ? 15 : 22,
      ),
      decoration: BoxDecoration(
        gradient: const LinearGradient(
          colors: [Color(0xff7f1d1d), Color(0xff991b1b), Color(0xffb91c1c)],
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
        ),
        borderRadius: BorderRadius.circular(mobile ? 20 : 24),
        boxShadow: [
          BoxShadow(
            color: const Color(0xff7f1d1d).withOpacity(.18),
            blurRadius: 22,
            offset: const Offset(0, 10),
          ),
        ],
      ),
      child: mobile
          ? Column(
              children: [
                Row(
                  children: [
                    Expanded(child: _buildCompanyName(mobile: true)),
                    const SizedBox(width: 10),
                    _buildLogo(mobile: true),
                  ],
                ),
                const SizedBox(height: 14),
                _buildClockWeather(mobile: true),
              ],
            )
          : Row(
              children: [
                Expanded(
                  child: Align(
                    alignment: Alignment.centerLeft,
                    child: _buildCompanyName(mobile: false),
                  ),
                ),
                const SizedBox(width: 20),
                _buildLogo(mobile: false),
                const SizedBox(width: 20),
                Expanded(
                  child: Align(
                    alignment: Alignment.centerRight,
                    child: _buildClockWeather(mobile: false),
                  ),
                ),
              ],
            ),
    );
  }

  Widget _buildCompanyName({required bool mobile}) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      mainAxisSize: MainAxisSize.min,
      children: [
        Text(
          _businessName,
          maxLines: 2,
          overflow: TextOverflow.ellipsis,
          style: TextStyle(
            color: Colors.white,
            fontSize: mobile ? 21 : 29,
            fontWeight: FontWeight.w800,
            height: 1.05,
            letterSpacing: -.3,
          ),
        ),
        const SizedBox(height: 5),
        Text(
          'Business Workspace',
          style: TextStyle(
            color: Colors.white.withOpacity(.72),
            fontSize: mobile ? 11 : 12.5,
            fontWeight: FontWeight.w500,
          ),
        ),
      ],
    );
  }

  Widget _buildLogo({required bool mobile}) {
    final size = mobile ? 58.0 : 76.0;

    return Container(
      width: size,
      height: size,
      padding: EdgeInsets.all(mobile ? 7 : 9),
      decoration: BoxDecoration(
        color: Colors.white.withOpacity(.96),
        borderRadius: BorderRadius.circular(mobile ? 17 : 21),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withOpacity(.10),
            blurRadius: 12,
            offset: const Offset(0, 5),
          ),
        ],
      ),
      child: Image.asset(
        GABBranding.logoAsset,
        fit: BoxFit.contain,
        errorBuilder: (_, __, ___) {
          return const Icon(Icons.storefront_rounded, color: Color(0xff991b1b));
        },
      ),
    );
  }

  Widget _buildClockWeather({required bool mobile}) {
    return Container(
      width: mobile ? double.infinity : 330,
      padding: EdgeInsets.symmetric(
        horizontal: mobile ? 12 : 15,
        vertical: mobile ? 10 : 12,
      ),
      decoration: BoxDecoration(
        color: Colors.white.withOpacity(.10),
        borderRadius: BorderRadius.circular(17),
        border: Border.all(color: Colors.white.withOpacity(.14)),
      ),
      child: Row(
        children: [
          Container(
            width: mobile ? 39 : 44,
            height: mobile ? 39 : 44,
            decoration: BoxDecoration(
              color: Colors.white.withOpacity(.13),
              shape: BoxShape.circle,
            ),
            child: const Icon(
              Icons.access_time_rounded,
              color: Colors.white,
              size: 21,
            ),
          ),
          const SizedBox(width: 10),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.end,
              mainAxisSize: MainAxisSize.min,
              children: [
                Text(
                  _timeText(),
                  maxLines: 1,
                  style: TextStyle(
                    color: Colors.white,
                    fontSize: mobile ? 14 : 16,
                    fontWeight: FontWeight.w800,
                    letterSpacing: .5,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  _dateText(),
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: TextStyle(
                    color: Colors.white.withOpacity(.76),
                    fontSize: mobile ? 10.5 : 11.5,
                    fontWeight: FontWeight.w500,
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(width: 10),

          // Weather placeholder only.
          // Real weather source will be connected separately.
          Container(
            width: mobile ? 39 : 44,
            height: mobile ? 39 : 44,
            decoration: BoxDecoration(
              color: Colors.white.withOpacity(.13),
              borderRadius: BorderRadius.circular(12),
            ),
            child: Icon(
              Icons.cloud_outlined,
              color: Colors.white.withOpacity(.88),
              size: 21,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildSixActionGrid({
    required bool mobile,
    required double? availableHeight,
  }) {
    final actions = [
      _DashboardAction(
        title: 'Quick Add',
        subtitle: 'Create master records',
        icon: Icons.add_circle_outline_rounded,
        onTap: () {
          QuickActionSheet.showQuickAdd(context);
        },
      ),
      _DashboardAction(
        title: 'Quick Entry',
        subtitle: 'Record transactions',
        icon: Icons.bolt_rounded,
        onTap: () {
          QuickActionSheet.showQuickEntry(context);
        },
      ),
      _DashboardAction(
        title: 'New Sale',
        subtitle: 'Create sale invoice',
        icon: Icons.point_of_sale_rounded,
        onTap: () => _open(const AddSaleScreen()),
      ),
      _DashboardAction(
        title: 'New Purchase',
        subtitle: 'Record purchase',
        icon: Icons.shopping_bag_rounded,
        onTap: () => _open(const PurchaseScreen()),
      ),
      _DashboardAction(
        title: 'Journal',
        subtitle: 'Double-entry journal',
        icon: Icons.menu_book_rounded,
        onTap: () => _open(const JournalScreen()),
      ),
      _DashboardAction(
        title: 'Business Overview',
        subtitle: 'Performance & balances',
        icon: Icons.dashboard_rounded,
        onTap: () => _open(const BusinessOverviewScreen()),
      ),
    ];

    if (mobile) {
      return GridView.builder(
        shrinkWrap: true,
        physics: const NeverScrollableScrollPhysics(),
        itemCount: actions.length,
        gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
          crossAxisCount: 2,
          crossAxisSpacing: 10,
          mainAxisSpacing: 10,
          childAspectRatio: 1.08,
        ),
        itemBuilder: (context, index) {
          return _dashboardTile(actions[index], mobile: true);
        },
      );
    }

    final height = availableHeight ?? 540.0;

    return SizedBox(
      height: height,
      child: GridView.builder(
        physics: const NeverScrollableScrollPhysics(),
        itemCount: actions.length,
        gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
          crossAxisCount: 2,
          crossAxisSpacing: 14,
          mainAxisSpacing: 14,
          childAspectRatio: 1,
        ),
        itemBuilder: (context, index) {
          return _dashboardTile(actions[index], mobile: false);
        },
      ),
    );
  }

  Widget _dashboardTile(_DashboardAction action, {required bool mobile}) {
    return Material(
      color: Colors.transparent,
      child: InkWell(
        onTap: action.onTap,
        borderRadius: BorderRadius.circular(22),
        child: Ink(
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(22),
            border: Border.all(color: const Color(0xffe9edf3)),
            boxShadow: [
              BoxShadow(
                color: Colors.black.withOpacity(.045),
                blurRadius: 18,
                offset: const Offset(0, 8),
              ),
            ],
          ),
          child: Center(
            child: Padding(
              padding: EdgeInsets.symmetric(
                horizontal: mobile ? 10 : 20,
                vertical: mobile ? 12 : 16,
              ),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                mainAxisSize: MainAxisSize.min,
                children: [
                  Container(
                    width: mobile ? 50 : 64,
                    height: mobile ? 50 : 64,
                    decoration: BoxDecoration(
                      color: const Color(0xfffef2f2),
                      borderRadius: BorderRadius.circular(mobile ? 15 : 19),
                    ),
                    child: Icon(
                      action.icon,
                      color: const Color(0xff991b1b),
                      size: mobile ? 25 : 31,
                    ),
                  ),
                  SizedBox(height: mobile ? 10 : 13),
                  Text(
                    action.title,
                    textAlign: TextAlign.center,
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                    style: TextStyle(
                      fontSize: mobile ? 15 : 20,
                      fontWeight: FontWeight.w800,
                      color: const Color(0xff202124),
                      height: 1.08,
                    ),
                  ),
                  SizedBox(height: mobile ? 5 : 6),
                  Text(
                    action.subtitle,
                    textAlign: TextAlign.center,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: TextStyle(
                      fontSize: mobile ? 10 : 12,
                      color: Colors.grey.shade600,
                      fontWeight: FontWeight.w500,
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}

class _DashboardAction {
  final String title;
  final String subtitle;
  final IconData icon;
  final VoidCallback onTap;

  const _DashboardAction({
    required this.title,
    required this.subtitle,
    required this.icon,
    required this.onTap,
  });
}
