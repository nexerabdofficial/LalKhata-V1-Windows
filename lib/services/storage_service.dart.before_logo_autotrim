import 'dart:io';

import 'package:file_picker/file_picker.dart';
import 'package:path_provider/path_provider.dart';
import 'package:shared_preferences/shared_preferences.dart';

class StorageService {
  StorageService._();

  static final StorageService instance = StorageService._();

  static const String _invoiceFolderKey = 'invoice_folder_path';

  static const String _backupFolderKey = 'backup_folder_path';

  static const String _invoiceLogoPathKey = 'invoice_logo_path';

  static const String _invoiceQrPathKey = 'invoice_qr_path';

  static const String _weatherLocationKey = 'weather_location';

  // ============================================================
  // SELECT INVOICE FOLDER
  // ============================================================

  Future<String?> selectInvoiceFolder() async {
    final selectedPath = await FilePicker.platform.getDirectoryPath(
      dialogTitle: 'Select Invoice Folder',
    );

    if (selectedPath == null || selectedPath.trim().isEmpty) {
      return null;
    }

    final prefs = await SharedPreferences.getInstance();

    await prefs.setString(_invoiceFolderKey, selectedPath);

    return selectedPath;
  }

  // ============================================================
  // GET INVOICE FOLDER
  // ============================================================

  Future<String?> getInvoiceFolder() async {
    final prefs = await SharedPreferences.getInstance();

    final path = prefs.getString(_invoiceFolderKey);

    if (path == null || path.trim().isEmpty) {
      return null;
    }

    return path;
  }

  // ============================================================
  // CLEAR INVOICE FOLDER
  // ============================================================

  Future<void> clearInvoiceFolder() async {
    final prefs = await SharedPreferences.getInstance();

    await prefs.remove(_invoiceFolderKey);
  }

  // ============================================================
  // SELECT BACKUP FOLDER
  // ============================================================

  Future<String?> selectBackupFolder() async {
    final selectedPath = await FilePicker.platform.getDirectoryPath(
      dialogTitle: 'Select Backup Folder',
    );

    if (selectedPath == null || selectedPath.trim().isEmpty) {
      return null;
    }

    final prefs = await SharedPreferences.getInstance();

    await prefs.setString(_backupFolderKey, selectedPath);

    return selectedPath;
  }

  // ============================================================
  // GET BACKUP FOLDER
  // ============================================================

  Future<String?> getBackupFolder() async {
    final prefs = await SharedPreferences.getInstance();

    final path = prefs.getString(_backupFolderKey);

    if (path == null || path.trim().isEmpty) {
      return null;
    }

    return path;
  }

  // ============================================================
  // CLEAR BACKUP FOLDER
  // ============================================================

  Future<void> clearBackupFolder() async {
    final prefs = await SharedPreferences.getInstance();

    await prefs.remove(_backupFolderKey);
  }

  // ============================================================
  // SELECT INVOICE LOGO
  // ============================================================

  Future<String?> selectInvoiceLogo() async {
    return _selectAndStoreInvoiceImage(
      key: _invoiceLogoPathKey,
      filePrefix: 'invoice_logo',
      dialogTitle: 'Select Invoice Logo',
    );
  }

  // ============================================================
  // GET INVOICE LOGO
  // ============================================================

  Future<String?> getInvoiceLogoPath() async {
    return _getExistingImagePath(_invoiceLogoPathKey);
  }

  // ============================================================
  // CLEAR INVOICE LOGO
  // ============================================================

  Future<void> clearInvoiceLogo() async {
    await _clearStoredImage(_invoiceLogoPathKey);
  }

  // ============================================================
  // SELECT INVOICE QR
  // ============================================================

  Future<String?> selectInvoiceQr() async {
    return _selectAndStoreInvoiceImage(
      key: _invoiceQrPathKey,
      filePrefix: 'invoice_qr',
      dialogTitle: 'Select Invoice QR Code',
    );
  }

  // ============================================================
  // GET INVOICE QR
  // ============================================================

  Future<String?> getInvoiceQrPath() async {
    return _getExistingImagePath(_invoiceQrPathKey);
  }

  // ============================================================
  // CLEAR INVOICE QR
  // ============================================================

  Future<void> clearInvoiceQr() async {
    await _clearStoredImage(_invoiceQrPathKey);
  }

  // ============================================================
  // WEATHER LOCATION
  // ============================================================

  Future<void> setWeatherLocation(String value) async {
    final prefs = await SharedPreferences.getInstance();
    final location = value.trim();

    if (location.isEmpty) {
      await prefs.remove(_weatherLocationKey);
      return;
    }

    await prefs.setString(_weatherLocationKey, location);
  }

  Future<String?> getWeatherLocation() async {
    final prefs = await SharedPreferences.getInstance();
    final value = prefs.getString(_weatherLocationKey);

    if (value == null || value.trim().isEmpty) {
      return null;
    }

    return value.trim();
  }

  Future<void> clearWeatherLocation() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove(_weatherLocationKey);
  }

  // ============================================================
  // INVOICE IMAGE STORAGE
  // ============================================================

  Future<String?> _selectAndStoreInvoiceImage({
    required String key,
    required String filePrefix,
    required String dialogTitle,
  }) async {
    final result = await FilePicker.platform.pickFiles(
      dialogTitle: dialogTitle,
      type: FileType.custom,
      allowedExtensions: ['png', 'jpg', 'jpeg', 'webp'],
      allowMultiple: false,
    );

    if (result == null ||
        result.files.isEmpty ||
        result.files.single.path == null) {
      return null;
    }

    final source = File(result.files.single.path!);

    if (!await source.exists()) {
      return null;
    }

    final prefs = await SharedPreferences.getInstance();

    final appSupport = await getApplicationSupportDirectory();

    final brandingDirectory = Directory('${appSupport.path}/invoice_branding');

    if (!await brandingDirectory.exists()) {
      await brandingDirectory.create(recursive: true);
    }

    final extension = source.path.split('.').last.toLowerCase();

    final destination = File(
      '${brandingDirectory.path}/'
      '$filePrefix.$extension',
    );

    final previousPath = prefs.getString(key);

    if (previousPath != null &&
        previousPath.trim().isNotEmpty &&
        previousPath != destination.path) {
      final previousFile = File(previousPath.trim());

      if (await previousFile.exists()) {
        try {
          await previousFile.delete();
        } catch (_) {}
      }
    }

    if (source.path != destination.path) {
      await source.copy(destination.path);
    }

    await prefs.setString(key, destination.path);

    return destination.path;
  }

  Future<String?> _getExistingImagePath(String key) async {
    final prefs = await SharedPreferences.getInstance();
    final path = prefs.getString(key);

    if (path == null || path.trim().isEmpty) {
      return null;
    }

    final file = File(path.trim());

    if (!await file.exists()) {
      await prefs.remove(key);
      return null;
    }

    return file.path;
  }

  Future<void> _clearStoredImage(String key) async {
    final prefs = await SharedPreferences.getInstance();
    final path = prefs.getString(key);

    if (path != null && path.trim().isNotEmpty) {
      final file = File(path.trim());

      if (await file.exists()) {
        try {
          await file.delete();
        } catch (_) {}
      }
    }

    await prefs.remove(key);
  }

  // ============================================================
  // CHECK DIRECTORY
  // ============================================================

  Future<bool> directoryExists(String? path) async {
    if (path == null || path.trim().isEmpty) {
      return false;
    }

    return Directory(path).exists();
  }

  // ============================================================
  // CHECK BACKUP FOLDER
  // ============================================================

  Future<bool> backupFolderExists() async {
    final path = await getBackupFolder();

    return directoryExists(path);
  }

  // ============================================================
  // CHECK INVOICE FOLDER
  // ============================================================

  Future<bool> invoiceFolderExists() async {
    final path = await getInvoiceFolder();

    return directoryExists(path);
  }
}
