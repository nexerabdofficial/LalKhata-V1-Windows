import 'dart:convert';

import 'package:http/http.dart' as http;
import 'package:shared_preferences/shared_preferences.dart';

class WeatherInfo {
  final double temperature;
  final int weatherCode;
  final String condition;
  final String locationName;
  final DateTime fetchedAt;

  const WeatherInfo({
    required this.temperature,
    required this.weatherCode,
    required this.condition,
    required this.locationName,
    required this.fetchedAt,
  });
}

class WeatherService {
  WeatherService._();

  static final WeatherService instance = WeatherService._();

  static const _cacheTemperature = 'weather_cache_temperature';
  static const _cacheCode = 'weather_cache_code';
  static const _cacheCondition = 'weather_cache_condition';
  static const _cacheLocation = 'weather_cache_location';
  static const _cacheTime = 'weather_cache_time';

  Future<WeatherInfo?> getCurrentWeather({
    required String businessAddress,
  }) async {
    final address = businessAddress.trim();

    if (address.isEmpty) {
      return _readCache();
    }

    try {
      final location = await _resolveLocation(address);

      if (location == null) {
        return _readCache();
      }

      final latitude = location.$1;
      final longitude = location.$2;
      final locationName = location.$3;

      final uri = Uri.https('api.open-meteo.com', '/v1/forecast', {
        'latitude': latitude.toString(),
        'longitude': longitude.toString(),
        'current': 'temperature_2m,weather_code',
        'timezone': 'auto',
      });

      final response = await http.get(uri).timeout(const Duration(seconds: 8));

      if (response.statusCode != 200) {
        return _readCache();
      }

      final decoded = jsonDecode(response.body);

      if (decoded is! Map<String, dynamic>) {
        return _readCache();
      }

      final current = decoded['current'];

      if (current is! Map<String, dynamic>) {
        return _readCache();
      }

      final rawTemperature = current['temperature_2m'];
      final rawCode = current['weather_code'];

      if (rawTemperature is! num || rawCode is! num) {
        return _readCache();
      }

      final code = rawCode.toInt();

      final info = WeatherInfo(
        temperature: rawTemperature.toDouble(),
        weatherCode: code,
        condition: conditionForCode(code),
        locationName: locationName,
        fetchedAt: DateTime.now(),
      );

      await _writeCache(info);

      return info;
    } catch (_) {
      return _readCache();
    }
  }

  Future<(double, double, String)?> _resolveLocation(String address) async {
    final candidates = _locationCandidates(address);

    for (final candidate in candidates) {
      try {
        final uri = Uri.https('geocoding-api.open-meteo.com', '/v1/search', {
          'name': candidate,
          'count': '5',
          'language': 'en',
          'format': 'json',
        });

        final response = await http
            .get(uri)
            .timeout(const Duration(seconds: 6));

        if (response.statusCode != 200) {
          continue;
        }

        final decoded = jsonDecode(response.body);

        if (decoded is! Map<String, dynamic>) {
          continue;
        }

        final results = decoded['results'];

        if (results is! List || results.isEmpty) {
          continue;
        }

        Map<String, dynamic>? selected;

        // Prefer Bangladesh result when available.
        for (final item in results) {
          if (item is! Map) continue;

          final map = Map<String, dynamic>.from(item);

          final countryCode = map['country_code']?.toString().toUpperCase();

          if (countryCode == 'BD') {
            selected = map;
            break;
          }
        }

        selected ??= results.first is Map
            ? Map<String, dynamic>.from(results.first as Map)
            : null;

        if (selected == null) {
          continue;
        }

        final latitude = selected['latitude'];
        final longitude = selected['longitude'];

        if (latitude is! num || longitude is! num) {
          continue;
        }

        final name = selected['name']?.toString().trim() ?? candidate;

        return (
          latitude.toDouble(),
          longitude.toDouble(),
          name.isEmpty ? candidate : name,
        );
      } catch (_) {
        // Try next candidate.
      }
    }

    return null;
  }

  List<String> _locationCandidates(String address) {
    final cleaned = address
        .replaceAll('\n', ',')
        .replaceAll(RegExp(r'\s+'), ' ')
        .trim();

    final parts = cleaned
        .split(',')
        .map((e) => e.trim())
        .where((e) => e.isNotEmpty)
        .toList();

    final candidates = <String>[];

    // Try later address components first because
    // city/district usually appears near the end.
    for (final part in parts.reversed) {
      final normalized = part
          .replaceAll(
            RegExp(
              r'\b(Bangladesh|BD|Division|District|Upazila|Thana)\b',
              caseSensitive: false,
            ),
            '',
          )
          .trim();

      if (normalized.length >= 3) {
        candidates.add(normalized);
      }
    }

    // Full address as final attempt.
    if (cleaned.isNotEmpty) {
      candidates.add(cleaned);
    }

    return candidates.toSet().toList();
  }

  Future<void> _writeCache(WeatherInfo info) async {
    final prefs = await SharedPreferences.getInstance();

    await prefs.setDouble(_cacheTemperature, info.temperature);

    await prefs.setInt(_cacheCode, info.weatherCode);

    await prefs.setString(_cacheCondition, info.condition);

    await prefs.setString(_cacheLocation, info.locationName);

    await prefs.setString(_cacheTime, info.fetchedAt.toIso8601String());
  }

  Future<WeatherInfo?> _readCache() async {
    final prefs = await SharedPreferences.getInstance();

    final temperature = prefs.getDouble(_cacheTemperature);
    final code = prefs.getInt(_cacheCode);
    final condition = prefs.getString(_cacheCondition);
    final location = prefs.getString(_cacheLocation);
    final rawTime = prefs.getString(_cacheTime);

    if (temperature == null ||
        code == null ||
        condition == null ||
        location == null) {
      return null;
    }

    return WeatherInfo(
      temperature: temperature,
      weatherCode: code,
      condition: condition,
      locationName: location,
      fetchedAt: DateTime.tryParse(rawTime ?? '') ?? DateTime.now(),
    );
  }

  static String conditionForCode(int code) {
    if (code == 0) return 'Clear';

    if (code == 1) return 'Mostly Clear';

    if (code == 2) return 'Partly Cloudy';

    if (code == 3) return 'Cloudy';

    if (code == 45 || code == 48) {
      return 'Foggy';
    }

    if (code >= 51 && code <= 57) {
      return 'Drizzle';
    }

    if (code >= 61 && code <= 67) {
      return 'Rain';
    }

    if (code >= 71 && code <= 77) {
      return 'Snow';
    }

    if (code >= 80 && code <= 82) {
      return 'Rain Showers';
    }

    if (code >= 85 && code <= 86) {
      return 'Snow Showers';
    }

    if (code >= 95) {
      return 'Thunderstorm';
    }

    return 'Weather';
  }
}
