import 'package:sqflite/sqflite.dart';

import '../../models/payment_allocation.dart';
import '../../models/sale.dart';
import 'ff_journal_models.dart';
import 'ff_journal_service.dart';
import 'ff_posting_engine.dart';
import 'ff_system_accounts.dart';

class FFSalePostingService {
  FFSalePostingService._();

  static final FFSalePostingService instance = FFSalePostingService._();

  final FFPostingEngine _postingEngine = FFPostingEngine.instance;

  final FFJournalService _journalService = FFJournalService.instance;

  final FFSystemAccounts _systemAccounts = FFSystemAccounts.instance;

  // ============================================================
  // LEGACY / SINGLE PAYMENT COMPATIBILITY
  // ============================================================

  Future<int> postSale({
    required int saleId,
    required Sale sale,
    required int paymentAccountId,
    required String voucherNo,
  }) async {
    final allocations = <PaymentAllocation>[];

    if (sale.paid > 0) {
      allocations.add(
        PaymentAllocation(
          referenceType: 'SALE',
          referenceId: saleId,
          accountId: paymentAccountId,
          amount: sale.paid,
          paymentMethod: sale.paymentMethod,
          createdAt: sale.createdAt,
        ),
      );
    }

    return postSaleWithAllocations(
      saleId: saleId,
      sale: sale,
      allocations: allocations,
      voucherNo: voucherNo,
    );
  }

  // ============================================================
  // MULTI ACCOUNT SALE POSTING
  // ============================================================

  Future<int> postSaleWithAllocations({
    required int saleId,
    required Sale sale,
    required List<PaymentAllocation> allocations,
    required String voucherNo,
  }) async {
    if (saleId <= 0) {
      throw ArgumentError('Invalid sale ID.');
    }

    if (sale.customerId <= 0) {
      throw ArgumentError('Invalid customer ID.');
    }

    if (sale.grandTotal <= 0) {
      throw ArgumentError('Sale grand total must be greater than zero.');
    }

    _validateAllocations(saleId: saleId, sale: sale, allocations: allocations);

    await _systemAccounts.ensureFoundation();

    final receivableAccountId = await _systemAccounts.resolveAccountId(
      FFSystemAccountCodes.customerReceivable,
    );

    final salesIncomeAccountId = await _systemAccounts.resolveAccountId(
      FFSystemAccountCodes.salesIncome,
    );

    final lines = _buildLines(
      sale: sale,
      allocations: allocations,
      receivableAccountId: receivableAccountId,
      salesIncomeAccountId: salesIncomeAccountId,
    );

    return _postingEngine.post(
      FFJournalEntry(
        transactionType: 'SALE',
        voucherNo: voucherNo,
        transactionDate: sale.saleDate,
        referenceType: 'SALE',
        referenceId: saleId,
        description: sale.note.trim().isEmpty ? 'Sale' : sale.note.trim(),
        createdAt: sale.createdAt,
        lines: lines,
      ),
    );
  }

  // ============================================================
  // MULTI ACCOUNT SALE POSTING INSIDE EXISTING DB TRANSACTION
  // ============================================================

  Future<int> postSaleWithExecutor(
    DatabaseExecutor db, {
    required int saleId,
    required Sale sale,
    required List<PaymentAllocation> allocations,
    required String voucherNo,
  }) async {
    if (saleId <= 0) {
      throw ArgumentError('Invalid sale ID.');
    }

    if (sale.customerId <= 0) {
      throw ArgumentError('Invalid customer ID.');
    }

    if (sale.grandTotal <= 0) {
      throw ArgumentError('Sale grand total must be greater than zero.');
    }

    _validateAllocations(saleId: saleId, sale: sale, allocations: allocations);

    final receivableAccountId = await _resolveSystemAccountId(
      db,
      FFSystemAccountCodes.customerReceivable,
    );

    final salesIncomeAccountId = await _resolveSystemAccountId(
      db,
      FFSystemAccountCodes.salesIncome,
    );

    final lines = _buildLines(
      sale: sale,
      allocations: allocations,
      receivableAccountId: receivableAccountId,
      salesIncomeAccountId: salesIncomeAccountId,
    );

    return _journalService.createJournalWithExecutor(
      db,
      FFJournalEntry(
        transactionType: 'SALE',
        voucherNo: voucherNo,
        transactionDate: sale.saleDate,
        referenceType: 'SALE',
        referenceId: saleId,
        description: sale.note.trim().isEmpty ? 'Sale' : sale.note.trim(),
        createdAt: sale.createdAt,
        lines: lines,
      ),
    );
  }

  // ============================================================
  // BUILD JOURNAL LINES
  // ============================================================

  List<FFJournalLine> _buildLines({
    required Sale sale,
    required List<PaymentAllocation> allocations,
    required int receivableAccountId,
    required int salesIncomeAccountId,
  }) {
    final totalPaid = allocations.fold<double>(
      0,
      (sum, item) => sum + item.amount,
    );

    final paidAgainstCurrentInvoice = totalPaid > sale.grandTotal
        ? sale.grandTotal
        : totalPaid;

    final currentInvoiceDue = sale.grandTotal - paidAgainstCurrentInvoice;

    final previousDueCollection = totalPaid > sale.grandTotal
        ? totalPaid - sale.grandTotal
        : 0.0;

    final lines = <FFJournalLine>[];

    for (final allocation in allocations) {
      if (allocation.amount <= 0) {
        continue;
      }

      lines.add(
        FFJournalLine(
          accountId: allocation.accountId,
          debit: allocation.amount,
          note: allocation.paymentMethod.trim().isEmpty
              ? 'Sale receipt'
              : 'Sale receipt - ${allocation.paymentMethod}',
        ),
      );
    }

    if (currentInvoiceDue > 0.000001) {
      lines.add(
        FFJournalLine(
          accountId: receivableAccountId,
          entityType: 'CUSTOMER',
          entityId: sale.customerId,
          debit: currentInvoiceDue,
          note: 'Current invoice receivable',
        ),
      );
    }

    lines.add(
      FFJournalLine(
        accountId: salesIncomeAccountId,
        credit: sale.grandTotal,
        note: 'Sales income',
      ),
    );

    if (previousDueCollection > 0.000001) {
      lines.add(
        FFJournalLine(
          accountId: receivableAccountId,
          entityType: 'CUSTOMER',
          entityId: sale.customerId,
          credit: previousDueCollection,
          note: 'Previous due collection',
        ),
      );
    }

    return lines;
  }

  // ============================================================
  // VALIDATION
  // ============================================================

  void _validateAllocations({
    required int saleId,
    required Sale sale,
    required List<PaymentAllocation> allocations,
  }) {
    if (sale.paid < 0) {
      throw ArgumentError('Sale paid amount cannot be negative.');
    }

    double allocationTotal = 0;

    for (final allocation in allocations) {
      if (allocation.referenceType != 'SALE') {
        throw ArgumentError('Invalid sale payment allocation reference type.');
      }

      if (allocation.referenceId != saleId) {
        throw ArgumentError('Sale payment allocation reference mismatch.');
      }

      if (allocation.accountId <= 0) {
        throw ArgumentError('Invalid sale payment account.');
      }

      if (allocation.amount <= 0) {
        throw ArgumentError(
          'Sale payment allocation must be greater than zero.',
        );
      }

      allocationTotal += allocation.amount;
    }

    if ((allocationTotal - sale.paid).abs() > 0.000001) {
      throw StateError(
        'Sale payment allocation total '
        '($allocationTotal) does not match '
        'sale paid amount (${sale.paid}).',
      );
    }
  }

  Future<int> _resolveSystemAccountId(DatabaseExecutor db, String type) async {
    final rows = await db.query(
      'accounts',
      columns: ['id'],
      where: 'type = ?',
      whereArgs: [type],
      orderBy: 'id ASC',
      limit: 1,
    );

    if (rows.isEmpty) {
      throw StateError('FF system account not found: $type');
    }

    return (rows.first['id'] as num).toInt();
  }
}
