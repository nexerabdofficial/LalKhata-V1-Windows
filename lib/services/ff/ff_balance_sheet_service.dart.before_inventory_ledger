import 'package:sqflite/sqflite.dart';

import '../../database/database_helper.dart';
import '../profit_repository.dart';

// ============================================================
// BALANCE SHEET ROW
// ============================================================

class FFBalanceSheetRow {
  final int accountId;
  final String accountName;
  final String accountType;
  final String groupCode;
  final String groupKind;
  final String accountNature;
  final double balance;

  const FFBalanceSheetRow({
    required this.accountId,
    required this.accountName,
    required this.accountType,
    required this.groupCode,
    required this.groupKind,
    required this.accountNature,
    required this.balance,
  });
}

// ============================================================
// BALANCE SHEET REPORT
// ============================================================

class FFBalanceSheetReport {
  final List<FFBalanceSheetRow> assets;
  final List<FFBalanceSheetRow> liabilities;
  final List<FFBalanceSheetRow> equity;

  final double inventoryValue;
  final double currentProfit;
  final double openingDifference;

  const FFBalanceSheetReport({
    required this.assets,
    required this.liabilities,
    required this.equity,
    required this.inventoryValue,
    required this.currentProfit,
    required this.openingDifference,
  });

  // ----------------------------------------------------------
  // ASSETS
  // ----------------------------------------------------------

  double get totalAssets {
    double total = inventoryValue;

    for (final row in assets) {
      // Inventory is represented by current physical stock value.
      // Therefore inventory ledger is not counted again.
      if (row.accountType == 'INVENTORY') {
        continue;
      }

      total += row.balance;
    }

    return total;
  }

  // ----------------------------------------------------------
  // LIABILITIES
  // ----------------------------------------------------------

  double get totalLiabilities {
    double total = 0;

    for (final row in liabilities) {
      total += row.balance;
    }

    return total;
  }

  // ----------------------------------------------------------
  // EQUITY
  // ----------------------------------------------------------

  double get ledgerEquity {
    double total = 0;

    for (final row in equity) {
      if (row.accountNature == 'DEBIT') {
        total -= row.balance;
      } else {
        total += row.balance;
      }
    }

    return total;
  }

  double get totalEquity {
    return ledgerEquity + currentProfit;
  }

  double get liabilitiesAndEquity {
    return totalLiabilities + totalEquity;
  }

  double get accountingDifference {
    return totalAssets - liabilitiesAndEquity;
  }
}

// ============================================================
// BALANCE SHEET SERVICE
// ============================================================

class FFBalanceSheetService {
  FFBalanceSheetService._();

  static final FFBalanceSheetService instance = FFBalanceSheetService._();

  final DatabaseHelper _databaseHelper = DatabaseHelper.instance;

  final ProfitRepository _profitRepository = ProfitRepository();

  // ==========================================================
  // PUBLIC REPORT
  // ==========================================================

  Future<FFBalanceSheetReport> getReport({DateTime? asOf}) async {
    final db = await _databaseHelper.database;

    final effectiveAsOf = asOf ?? DateTime(9999, 12, 31, 23, 59, 59, 999);

    final rows = await _loadAccounts(db, effectiveAsOf.toIso8601String());

    final inventoryValue = await _loadInventoryValue(db);

    final profitStatement = await _profitRepository.getProfitStatement(
      from: DateTime(2000, 1, 1),
      to: effectiveAsOf,
    );

    final openingDifference = await _calculateOpeningDifference(db);

    return FFBalanceSheetReport(
      assets: rows.where((row) => row.groupKind == 'ASSET').toList(),
      liabilities: rows.where((row) => row.groupKind == 'LIABILITY').toList(),
      equity: rows.where((row) => row.groupKind == 'EQUITY').toList(),
      inventoryValue: inventoryValue,
      currentProfit: profitStatement.netProfit,
      openingDifference: openingDifference,
    );
  }

  // ==========================================================
  // LOAD BALANCE SHEET ACCOUNTS
  //
  // IMPORTANT:
  // Every ledger is counted exactly once.
  //
  // Party opening balances belong to individual CUSTOMER /
  // SUPPLIER ledgers.
  //
  // CUSTOMER_RECEIVABLE and SUPPLIER_PAYABLE aggregate
  // accounts are compatibility/control accounts only.
  // No customer/supplier opening balance is injected here.
  // ==========================================================

  Future<List<FFBalanceSheetRow>> _loadAccounts(
    DatabaseExecutor db,
    String asOfIso,
  ) async {
    final rows = await db.rawQuery(
      '''
      SELECT
        a.id,
        a.name,
        a.type,

        COALESCE(g.group_code, '') AS group_code,
        COALESCE(g.group_kind, '') AS group_kind,
        COALESCE(g.account_nature, '') AS account_nature,

        COALESCE(a.opening_balance, 0) AS opening_balance,

        COALESCE(
          SUM(
            CASE
              WHEN je.transaction_date <= ?
              THEN jl.debit
              ELSE 0
            END
          ),
          0
        ) AS total_debit,

        COALESCE(
          SUM(
            CASE
              WHEN je.transaction_date <= ?
              THEN jl.credit
              ELSE 0
            END
          ),
          0
        ) AS total_credit

      FROM accounts a

      INNER JOIN ff_account_links l
        ON l.account_id = a.id
       AND l.is_primary = 1

      INNER JOIN ff_account_groups g
        ON g.id = l.group_id

      LEFT JOIN journal_lines jl
        ON jl.account_id = a.id

      LEFT JOIN journal_entries je
        ON je.id = jl.journal_id

      WHERE g.group_kind IN (
        'ASSET',
        'LIABILITY',
        'EQUITY'
      )

      GROUP BY
        a.id,
        a.name,
        a.type,
        a.opening_balance,
        g.group_code,
        g.group_kind,
        g.account_nature

      ORDER BY
        g.group_kind,
        g.group_code,
        a.name
      ''',
      [asOfIso, asOfIso],
    );

    final result = <FFBalanceSheetRow>[];

    for (final row in rows) {
      final nature = row['account_nature']?.toString().toUpperCase() ?? '';

      final opening = _toDouble(row['opening_balance']);

      final debit = _toDouble(row['total_debit']);

      final credit = _toDouble(row['total_credit']);

      final balance = nature == 'CREDIT'
          ? opening + credit - debit
          : opening + debit - credit;

      result.add(
        FFBalanceSheetRow(
          accountId: (row['id'] as num).toInt(),
          accountName: row['name']?.toString() ?? '',
          accountType: row['type']?.toString() ?? '',
          groupCode: row['group_code']?.toString() ?? '',
          groupKind: row['group_kind']?.toString() ?? '',
          accountNature: nature,
          balance: balance,
        ),
      );
    }

    return result;
  }

  // ==========================================================
  // INVENTORY
  //
  // Balance Sheet inventory is the current physical inventory
  // valuation already maintained by the stock/costing engine.
  //
  // Do NOT calculate current inventory again from journal.
  // Do NOT modify weighted-average costing here.
  // ==========================================================

  Future<double> _loadInventoryValue(DatabaseExecutor db) async {
    final result = await db.rawQuery('''
      SELECT
        COALESCE(
          SUM(stock_value),
          0
        ) AS total
      FROM products
      ''');

    return _toDouble(result.first['total']);
  }

  // ==========================================================
  // OPENING CONTROL
  //
  // This is diagnostic only.
  // It does NOT create capital.
  // It does NOT post a journal.
  // It does NOT force the Balance Sheet to balance.
  // ==========================================================

  Future<double> _calculateOpeningDifference(DatabaseExecutor db) async {
    final rows = await db.rawQuery('''
      SELECT
        COALESCE(a.opening_balance, 0)
          AS opening_balance,

        COALESCE(
          g.account_nature,
          ''
        ) AS account_nature

      FROM accounts a

      INNER JOIN ff_account_links l
        ON l.account_id = a.id
       AND l.is_primary = 1

      INNER JOIN ff_account_groups g
        ON g.id = l.group_id

      WHERE g.group_kind IN (
        'ASSET',
        'LIABILITY',
        'EQUITY'
      )
      ''');

    double debitOpening = 0;
    double creditOpening = 0;

    for (final row in rows) {
      final amount = _toDouble(row['opening_balance']);

      final nature = row['account_nature']?.toString().toUpperCase() ?? '';

      if (nature == 'DEBIT') {
        debitOpening += amount;
      } else if (nature == 'CREDIT') {
        creditOpening += amount;
      }
    }

    return debitOpening - creditOpening;
  }

  // ==========================================================
  // DOUBLE HELPER
  // ==========================================================

  double _toDouble(dynamic value) {
    if (value is num) {
      return value.toDouble();
    }

    return double.tryParse(value?.toString() ?? '') ?? 0;
  }
}
