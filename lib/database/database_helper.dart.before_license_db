    // ============================================================

    if (oldVersion < 29) {
      await _addColumnIfMissing(db, 'customers', 'supabase_id', 'TEXT');

      await _addColumnIfMissing(db, 'customers', 'customer_code', 'TEXT');
    }

    // ============================================================
    // VERSION 30
    // Weighted Average Stock Valuation
    // ============================================================

    if (oldVersion < 30) {
      await _addColumnIfMissing(
