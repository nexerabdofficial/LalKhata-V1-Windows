import 'dart:io';
import 'dart:typed_data';

import 'package:intl/intl.dart';
import 'package:path/path.dart' as p;
import 'package:path_provider/path_provider.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';

import '../config/app_build_config.dart';
import '../gab/gab_branding.dart';
import '../services/ff/ff_balance_sheet_service.dart';
import '../services/storage_service.dart';

class BalanceSheetPdf {
  BalanceSheetPdf._();

  static final StorageService _storageService = StorageService.instance;

  static Future<pw.MemoryImage?> _loadImage(String? path) async {
    try {
      if (path == null || path.trim().isEmpty) return null;

      final file = File(path.trim());

      if (!await file.exists()) return null;

      final bytes = await file.readAsBytes();

      if (bytes.isEmpty) return null;

      return pw.MemoryImage(bytes);
    } catch (_) {
      return null;
    }
  }

  static Future<pw.MemoryImage?> _logo() async {
    return _loadImage(await _storageService.getInvoiceLogoPath());
  }

  static Future<pw.MemoryImage?> _qr() async {
    return _loadImage(await _storageService.getInvoiceQrPath());
  }

  static pw.Widget _imagePlate(pw.MemoryImage image, {required bool qr}) {
    return pw.Container(
      width: qr ? 72 : 118,
      height: qr ? 72 : 58,
      alignment: pw.Alignment.center,
      child: pw.Image(image, fit: pw.BoxFit.contain),
    );
  }

  static Future<Uint8List> generate({
    required FFBalanceSheetReport report,
  }) async {
    final regular = await PdfGoogleFonts.notoSansRegular();
    final bold = await PdfGoogleFonts.notoSansBold();

    final logo = await _logo();
    final qr = await _qr();

    final pdf = pw.Document();

    final money = NumberFormat('#,##0.00');

    String tk(num value) {
      final amount = value.toDouble();

      if (amount < 0) {
        return '-Tk ${money.format(amount.abs())}';
      }

      return 'Tk ${money.format(amount)}';
    }

    final generatedAt = DateFormat(
      'dd MMM yyyy  hh:mm a',
    ).format(DateTime.now());

    pw.Widget amountRow(String label, double amount, {bool boldRow = false}) {
      return pw.Padding(
        padding: const pw.EdgeInsets.symmetric(horizontal: 8, vertical: 5),
        child: pw.Row(
          children: [
            pw.Expanded(
              child: pw.Text(
                label,
                style: pw.TextStyle(
                  font: boldRow ? bold : regular,
                  fontSize: boldRow ? 9.5 : 8.5,
                ),
              ),
            ),
            pw.Text(
              tk(amount),
              style: pw.TextStyle(
                font: boldRow ? bold : regular,
                fontSize: boldRow ? 9.5 : 8.5,
              ),
            ),
          ],
        ),
      );
    }

    pw.Widget section({
      required String title,
      required List<pw.Widget> children,
    }) {
      return pw.Container(
        margin: const pw.EdgeInsets.only(bottom: 10),
        decoration: pw.BoxDecoration(
          border: pw.Border.all(color: PdfColors.grey400, width: .5),
        ),
        child: pw.Column(
          children: [
            pw.Container(
              width: double.infinity,
              padding: const pw.EdgeInsets.symmetric(
                horizontal: 8,
                vertical: 6,
              ),
              color: PdfColors.grey200,
              child: pw.Text(
                title,
                style: pw.TextStyle(
                  font: bold,
                  fontSize: 9.5,
                  color: PdfColors.blue900,
                ),
              ),
            ),
            ...children,
          ],
        ),
      );
    }

    final assetRows = <pw.Widget>[];

    for (final row in report.assets) {
      if (row.accountType == 'INVENTORY') continue;
      if (row.balance.abs() < 0.000001) continue;

      assetRows.add(amountRow(row.accountName, row.balance));
    }

    assetRows.add(amountRow('Inventory / Stock', report.inventoryValue));

    assetRows.add(pw.Divider(height: 1, color: PdfColors.grey400));

    assetRows.add(amountRow('TOTAL ASSETS', report.totalAssets, boldRow: true));

    final liabilityRows = <pw.Widget>[];

    for (final row in report.liabilities) {
      if (row.balance.abs() < 0.000001) continue;

      liabilityRows.add(amountRow(row.accountName, row.balance));
    }

    liabilityRows.add(pw.Divider(height: 1, color: PdfColors.grey400));

    liabilityRows.add(
      amountRow('TOTAL LIABILITIES', report.totalLiabilities, boldRow: true),
    );

    final equityRows = <pw.Widget>[];

    for (final row in report.equity) {
      if (row.balance.abs() < 0.000001) continue;

      final displayed = row.accountNature == 'DEBIT'
          ? -row.balance
          : row.balance;

      equityRows.add(amountRow(row.accountName, displayed));
    }

    equityRows.add(
      amountRow(
        report.currentProfit >= 0 ? 'Current Profit' : 'Current Loss',
        report.currentProfit,
      ),
    );

    equityRows.add(pw.Divider(height: 1, color: PdfColors.grey400));

    equityRows.add(
      amountRow('TOTAL EQUITY', report.totalEquity, boldRow: true),
    );

    final balanced = report.accountingDifference.abs() < 0.005;

    pdf.addPage(
      pw.MultiPage(
        pageFormat: PdfPageFormat.a4,
        margin: const pw.EdgeInsets.fromLTRB(24, 22, 24, 22),

        footer: (context) {
          return pw.Container(
            padding: const pw.EdgeInsets.only(top: 5),
            decoration: const pw.BoxDecoration(
              border: pw.Border(
                top: pw.BorderSide(color: PdfColors.grey400, width: .5),
              ),
            ),
            child: pw.Row(
              mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
              children: [
                if (AppBuildConfig.showDeveloperBranding)
                  pw.RichText(
                    text: pw.TextSpan(
                      children: [
                        pw.TextSpan(
                          text: 'Developed by ',
                          style: pw.TextStyle(
                            font: regular,
                            fontSize: 8,
                            color: PdfColors.grey700,
                          ),
                        ),
                        pw.TextSpan(
                          text: 'Nexera IT BD',
                          style: pw.TextStyle(
                            font: bold,
                            fontSize: 8,
                            color: PdfColors.blue900,
                          ),
                        ),
                      ],
                    ),
                  )
                else
                  pw.SizedBox(),
                pw.Text(
                  'Page ${context.pageNumber} / '
                  '${context.pagesCount}',
                  style: pw.TextStyle(
                    font: regular,
                    fontSize: 8,
                    color: PdfColors.grey700,
                  ),
                ),
              ],
            ),
          );
        },

        build: (_) => [
          if (logo != null || qr != null)
            pw.Padding(
              padding: const pw.EdgeInsets.only(bottom: 8),
              child: logo != null && qr != null
                  ? pw.Row(
                      mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                      children: [
                        _imagePlate(logo, qr: false),
                        _imagePlate(qr, qr: true),
                      ],
                    )
                  : pw.Center(child: _imagePlate(logo ?? qr!, qr: qr != null)),
            ),

          pw.Center(
            child: pw.Column(
              children: [
                pw.Text(
                  GABBranding.businessName,
                  textAlign: pw.TextAlign.center,
                  style: pw.TextStyle(
                    font: bold,
                    fontSize: 18,
                    color: PdfColors.blue900,
                  ),
                ),

                if (GABBranding.tagline.trim().isNotEmpty) ...[
                  pw.SizedBox(height: 2),
                  pw.Text(
                    GABBranding.tagline,
                    style: pw.TextStyle(
                      font: regular,
                      fontSize: 8.5,
                      color: PdfColors.grey700,
                    ),
                  ),
                ],

                if (GABBranding.address.trim().isNotEmpty) ...[
                  pw.SizedBox(height: 3),
                  pw.Text(
                    GABBranding.address,
                    textAlign: pw.TextAlign.center,
                    style: pw.TextStyle(font: regular, fontSize: 8.5),
                  ),
                ],

                if (GABBranding.phone.trim().isNotEmpty ||
                    GABBranding.email.trim().isNotEmpty) ...[
                  pw.SizedBox(height: 2),
                  pw.Text(
                    [
                      if (GABBranding.phone.trim().isNotEmpty)
                        GABBranding.phone,
                      if (GABBranding.email.trim().isNotEmpty)
                        GABBranding.email,
                    ].join('  |  '),
                    style: pw.TextStyle(font: regular, fontSize: 8.5),
                  ),
                ],
              ],
            ),
          ),

          pw.SizedBox(height: 12),

          pw.Container(
            width: double.infinity,
            padding: const pw.EdgeInsets.symmetric(vertical: 7),
            color: PdfColors.blue900,
            child: pw.Text(
              'BALANCE SHEET',
              textAlign: pw.TextAlign.center,
              style: pw.TextStyle(
                font: bold,
                fontSize: 13,
                color: PdfColors.white,
              ),
            ),
          ),

          pw.SizedBox(height: 4),

          pw.Center(
            child: pw.Text(
              'Statement of Financial Position',
              style: pw.TextStyle(
                font: regular,
                fontSize: 8.5,
                color: PdfColors.grey700,
              ),
            ),
          ),

          pw.SizedBox(height: 3),

          pw.Align(
            alignment: pw.Alignment.centerRight,
            child: pw.Text(
              'Generated: $generatedAt',
              style: pw.TextStyle(
                font: regular,
                fontSize: 7.5,
                color: PdfColors.grey700,
              ),
            ),
          ),

          pw.SizedBox(height: 12),

          section(title: 'ASSETS', children: assetRows),

          section(title: 'LIABILITIES', children: liabilityRows),

          section(title: 'EQUITY', children: equityRows),

          pw.Container(
            decoration: pw.BoxDecoration(
              border: pw.Border.all(color: PdfColors.blue900, width: .8),
            ),
            child: pw.Column(
              children: [
                pw.Container(
                  width: double.infinity,
                  padding: const pw.EdgeInsets.symmetric(
                    horizontal: 8,
                    vertical: 6,
                  ),
                  color: PdfColors.grey200,
                  child: pw.Text(
                    'ACCOUNTING CONTROL',
                    style: pw.TextStyle(
                      font: bold,
                      fontSize: 9.5,
                      color: PdfColors.blue900,
                    ),
                  ),
                ),

                amountRow('Total Assets', report.totalAssets),

                amountRow('Liabilities + Equity', report.liabilitiesAndEquity),

                pw.Divider(height: 1, color: PdfColors.grey400),

                amountRow(
                  'Balance Sheet Difference',
                  report.accountingDifference,
                  boldRow: true,
                ),

                pw.Padding(
                  padding: const pw.EdgeInsets.fromLTRB(8, 4, 8, 8),
                  child: pw.Align(
                    alignment: pw.Alignment.centerLeft,
                    child: pw.Text(
                      balanced
                          ? 'Balance Sheet is balanced.'
                          : 'Difference is shown as a control only. '
                                'No artificial capital or balancing '
                                'journal has been created.',
                      style: pw.TextStyle(
                        font: regular,
                        fontSize: 7.5,
                        color: PdfColors.grey700,
                      ),
                    ),
                  ),
                ),

                if (report.openingDifference.abs() > 0.005)
                  pw.Padding(
                    padding: const pw.EdgeInsets.fromLTRB(8, 0, 8, 8),
                    child: pw.Align(
                      alignment: pw.Alignment.centerLeft,
                      child: pw.Text(
                        'Brought-forward opening difference: '
                        '${tk(report.openingDifference)}',
                        style: pw.TextStyle(
                          font: regular,
                          fontSize: 7.5,
                          color: PdfColors.grey700,
                        ),
                      ),
                    ),
                  ),
              ],
            ),
          ),

          pw.SizedBox(height: 16),

          pw.Center(
            child: pw.Text(
              'Thank you for your business.',
              style: pw.TextStyle(
                font: bold,
                fontSize: 9,
                color: PdfColors.grey700,
              ),
            ),
          ),
        ],
      ),
    );

    return pdf.save();
  }

  static Future<File> savePdf({required FFBalanceSheetReport report}) async {
    final bytes = await generate(report: report);

    final root = await getApplicationDocumentsDirectory();

    final folder = Directory(p.join(root.path, 'LalKhata', 'Reports'));

    if (!await folder.exists()) {
      await folder.create(recursive: true);
    }

    final file = File(
      p.join(
        folder.path,
        'Balance_Sheet_'
        '${DateFormat('yyyyMMdd_HHmmss').format(DateTime.now())}.pdf',
      ),
    );

    await file.writeAsBytes(bytes, flush: true);

    return file;
  }
}
