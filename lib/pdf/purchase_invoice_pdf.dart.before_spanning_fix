import 'dart:io';
import 'dart:typed_data';

import '../config/app_build_config.dart';
import '../database/database_helper.dart';
import '../gab/gab_branding.dart';
import '../models/purchase.dart';
import '../models/purchase/purchase_item_history.dart';
import '../services/storage_service.dart';

import 'package:intl/intl.dart';
import 'package:path/path.dart' as p;
import 'package:path_provider/path_provider.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';

class PurchaseInvoicePdf {
  PurchaseInvoicePdf._();

  static final StorageService _storageService = StorageService.instance;

  static Future<pw.MemoryImage?> _loadImage(String? path) async {
    try {
      if (path == null || path.trim().isEmpty) {
        return null;
      }

      final file = File(path.trim());

      if (!await file.exists()) {
        return null;
      }

      final bytes = await file.readAsBytes();

      if (bytes.isEmpty) {
        return null;
      }

      return pw.MemoryImage(bytes);
    } catch (_) {
      return null;
    }
  }

  static Future<Uint8List> generate({
    required Purchase purchase,
    required List<PurchaseItemHistory> items,
  }) async {
    await GABBranding.refresh();

    final pdf = pw.Document();

    final regularFont = await PdfGoogleFonts.notoSansRegular();
    final boldFont = await PdfGoogleFonts.notoSansBold();

    final logo = await _loadImage(await _storageService.getInvoiceLogoPath());

    final qr = await _loadImage(await _storageService.getInvoiceQrPath());

    final db = await DatabaseHelper.instance.database;

    // ==========================================================
    // SUPPLIER
    // ==========================================================

    final supplierRows = await db.query(
      'suppliers',
      where: 'id = ?',
      whereArgs: [purchase.supplierId],
      limit: 1,
    );

    final supplier = supplierRows.isEmpty
        ? <String, Object?>{}
        : supplierRows.first;

    final supplierName = supplier['name']?.toString() ?? 'Supplier';

    final supplierPhone = supplier['phone']?.toString() ?? '';

    final supplierAddress = supplier['address']?.toString() ?? '';

    // Current supplier balance is after this purchase.
    // Previous due = current balance - this invoice due.
    final supplierBalance = ((supplier['balance'] ?? 0) as num).toDouble();

    final previousDue = (supplierBalance - purchase.due)
        .clamp(0, double.infinity)
        .toDouble();

    // ==========================================================
    // PAYMENT BREAKDOWN
    // ==========================================================

    final paymentBreakdown = <Map<String, dynamic>>[];

    if (purchase.id != null) {
      final rows = await db.rawQuery(
        '''
        SELECT
          pa.amount,
          pa.payment_method,
          a.name AS account_name
        FROM payment_allocations pa
        LEFT JOIN accounts a
          ON a.id = pa.account_id
        WHERE pa.reference_type = ?
          AND pa.reference_id = ?
        ORDER BY pa.id ASC
        ''',
        ['PURCHASE', purchase.id],
      );

      for (final row in rows) {
        final amount = ((row['amount'] ?? 0) as num).toDouble();

        if (amount <= 0) continue;

        final account = row['account_name']?.toString().trim() ?? '';

        final method = row['payment_method']?.toString().trim() ?? '';

        paymentBreakdown.add({
          'name': account.isNotEmpty
              ? account
              : method.isNotEmpty
              ? method
              : 'Payment',
          'amount': amount,
        });
      }
    }

    // ==========================================================
    // VALUES
    // ==========================================================

    final currency = NumberFormat('#,##0.00');

    String taka(num value) => 'Tk ${currency.format(value)}';

    final subtotal =
        purchase.grandTotal -
        purchase.additionalCharge +
        purchase.invoiceDiscount;

    final totalPayable = previousDue + purchase.grandTotal;

    final balanceDue = (totalPayable - purchase.paid)
        .clamp(0, double.infinity)
        .toDouble();

    final companyName = GABBranding.businessName.trim().isEmpty
        ? 'My Business'
        : GABBranding.businessName.trim();

    final companyPhone = GABBranding.phone.trim();
    final companyAddress = GABBranding.address.trim();

    final date = DateFormat(
      'dd MMM yyyy  hh:mm a',
    ).format(DateTime.tryParse(purchase.purchaseDate) ?? DateTime.now());

    final invoiceNo = purchase.invoiceNo?.trim().isNotEmpty == true
        ? purchase.invoiceNo!.trim()
        : 'PUR-${purchase.id ?? ''}';

    final content = pw.Column(
      crossAxisAlignment: pw.CrossAxisAlignment.stretch,
      mainAxisSize: pw.MainAxisSize.min,
      children: [
        // ====================================================
        // BRANDING
        // ====================================================
        if (logo != null || qr != null)
          pw.Padding(
            padding: const pw.EdgeInsets.only(bottom: 8),
            child: logo != null && qr != null
                ? pw.Row(
                    mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                    children: [
                      _brandingImage(logo, width: 105),
                      _brandingImage(qr, width: 72),
                    ],
                  )
                : pw.Center(
                    child: _brandingImage(
                      logo ?? qr!,
                      width: logo != null ? 105 : 72,
                    ),
                  ),
          ),

        // ====================================================
        // HEADER
        // ====================================================
        pw.Container(
          padding: const pw.EdgeInsets.all(14),
          decoration: pw.BoxDecoration(
            color: PdfColors.blue900,
            borderRadius: pw.BorderRadius.circular(7),
          ),
          child: pw.Row(
            crossAxisAlignment: pw.CrossAxisAlignment.start,
            children: [
              pw.Expanded(
                child: pw.Column(
                  crossAxisAlignment: pw.CrossAxisAlignment.start,
                  children: [
                    pw.Text(
                      companyName,
                      style: pw.TextStyle(
                        font: boldFont,
                        fontSize: 17,
                        color: PdfColors.white,
                      ),
                    ),
                    if (companyPhone.isNotEmpty)
                      pw.Text(
                        companyPhone,
                        style: pw.TextStyle(
                          font: regularFont,
                          fontSize: 9,
                          color: PdfColors.white,
                        ),
                      ),
                    if (companyAddress.isNotEmpty)
                      pw.Text(
                        companyAddress,
                        style: pw.TextStyle(
                          font: regularFont,
                          fontSize: 9,
                          color: PdfColors.white,
                        ),
                      ),
                  ],
                ),
              ),
              pw.SizedBox(width: 14),
              pw.Container(
                width: 165,
                padding: const pw.EdgeInsets.all(10),
                decoration: pw.BoxDecoration(
                  color: PdfColors.white,
                  borderRadius: pw.BorderRadius.circular(5),
                ),
                child: pw.Column(
                  crossAxisAlignment: pw.CrossAxisAlignment.start,
                  children: [
                    pw.Center(
                      child: pw.Text(
                        'PURCHASE INVOICE',
                        style: pw.TextStyle(
                          font: boldFont,
                          fontSize: 13,
                          color: PdfColors.blue900,
                        ),
                      ),
                    ),
                    pw.Divider(height: 8),
                    _labelValue('Invoice No', invoiceNo, regularFont, boldFont),
                    pw.SizedBox(height: 4),
                    _labelValue('Invoice Date', date, regularFont, boldFont),
                  ],
                ),
              ),
            ],
          ),
        ),

        pw.SizedBox(height: 14),

        // ====================================================
        // SUPPLIER + TOTAL
        // ====================================================
        pw.Row(
          crossAxisAlignment: pw.CrossAxisAlignment.stretch,
          children: [
            pw.Expanded(
              child: _infoBox(
                title: 'BILL FROM',
                font: regularFont,
                boldFont: boldFont,
                children: [
                  supplierName,
                  'Supplier ID : ${purchase.supplierId}',
                  if (supplierPhone.isNotEmpty) 'Phone : $supplierPhone',
                  if (supplierAddress.isNotEmpty) 'Address : $supplierAddress',
                ],
              ),
            ),
            pw.SizedBox(width: 10),
            pw.Container(
              width: 205,
              padding: const pw.EdgeInsets.all(10),
              decoration: pw.BoxDecoration(
                color: PdfColors.grey100,
                borderRadius: pw.BorderRadius.circular(6),
              ),
              child: pw.Column(
                children: [
                  _moneyRow(
                    'Invoice Total',
                    taka(purchase.grandTotal),
                    regularFont,
                    boldFont,
                  ),
                  _moneyRow(
                    'Previous Due (BF)',
                    taka(previousDue),
                    regularFont,
                    boldFont,
                  ),
                  pw.Divider(),
                  _moneyRow(
                    'Total Payable',
                    taka(totalPayable),
                    regularFont,
                    boldFont,
                    strong: true,
                  ),
                ],
              ),
            ),
          ],
        ),

        pw.SizedBox(height: 14),

        // ====================================================
        // ITEMS
        // ====================================================
        pw.Table(
          border: pw.TableBorder.all(color: PdfColors.grey300, width: .6),
          columnWidths: const {
            0: pw.FixedColumnWidth(32),
            1: pw.FlexColumnWidth(),
            2: pw.FixedColumnWidth(55),
            3: pw.FixedColumnWidth(90),
            4: pw.FixedColumnWidth(95),
          },
          children: [
            pw.TableRow(
              decoration: const pw.BoxDecoration(color: PdfColors.blue900),
              children: [
                _tableCell('SL', boldFont, header: true),
                _tableCell('PRODUCT', boldFont, header: true),
                _tableCell('QTY', boldFont, header: true),
                _tableCell('PRICE', boldFont, header: true),
                _tableCell('TOTAL', boldFont, header: true),
              ],
            ),
            ...items.asMap().entries.map((entry) {
              final item = entry.value;

              return pw.TableRow(
                children: [
                  _tableCell('${entry.key + 1}', regularFont),
                  _tableCell(item.productName, regularFont, left: true),
                  _tableCell('${item.item.qty}', regularFont),
                  _tableCell(taka(item.item.purchasePrice), regularFont),
                  _tableCell(taka(item.item.subtotal), boldFont),
                ],
              );
            }),
          ],
        ),

        pw.SizedBox(height: 14),

        // ====================================================
        // PAYMENT SUMMARY
        // ====================================================
        pw.Container(
          padding: const pw.EdgeInsets.all(12),
          decoration: pw.BoxDecoration(
            color: PdfColors.grey100,
            borderRadius: pw.BorderRadius.circular(7),
          ),
          child: pw.Column(
            crossAxisAlignment: pw.CrossAxisAlignment.stretch,
            children: [
              pw.Text(
                'PAYMENT SUMMARY',
                style: pw.TextStyle(
                  font: boldFont,
                  fontSize: 11,
                  color: PdfColors.blue900,
                ),
              ),
              pw.SizedBox(height: 7),

              _moneyRow('Subtotal', taka(subtotal), regularFont, boldFont),

              if (purchase.additionalCharge > 0)
                _moneyRow(
                  'Additional Charge',
                  taka(purchase.additionalCharge),
                  regularFont,
                  boldFont,
                ),

              if (purchase.invoiceDiscount > 0)
                _moneyRow(
                  'Invoice Discount',
                  '-${taka(purchase.invoiceDiscount)}',
                  regularFont,
                  boldFont,
                ),

              _moneyRow(
                'Current Purchase',
                taka(purchase.grandTotal),
                regularFont,
                boldFont,
                strong: true,
              ),

              _moneyRow(
                'Previous Due (BF)',
                taka(previousDue),
                regularFont,
                boldFont,
              ),

              _moneyRow(
                'Total Payable',
                taka(totalPayable),
                regularFont,
                boldFont,
                strong: true,
              ),

              pw.SizedBox(height: 5),

              _moneyRow(
                'Payment Method',
                paymentBreakdown.length > 1
                    ? 'Split Payment'
                    : purchase.paymentMethod,
                regularFont,
                boldFont,
              ),

              ...paymentBreakdown.map(
                (payment) => _moneyRow(
                  '• ${payment['name']}',
                  taka((payment['amount'] as num).toDouble()),
                  regularFont,
                  boldFont,
                ),
              ),

              _moneyRow(
                'Paid Today',
                taka(purchase.paid),
                regularFont,
                boldFont,
                strong: true,
              ),

              pw.SizedBox(height: 7),

              pw.Container(
                padding: const pw.EdgeInsets.symmetric(
                  horizontal: 10,
                  vertical: 8,
                ),
                decoration: pw.BoxDecoration(
                  color: PdfColors.blue900,
                  borderRadius: pw.BorderRadius.circular(5),
                ),
                child: pw.Row(
                  mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                  children: [
                    pw.Text(
                      'BALANCE DUE',
                      style: pw.TextStyle(
                        font: boldFont,
                        fontSize: 11,
                        color: PdfColors.white,
                      ),
                    ),
                    pw.Text(
                      taka(balanceDue),
                      style: pw.TextStyle(
                        font: boldFont,
                        fontSize: 12,
                        color: PdfColors.white,
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),

        pw.SizedBox(height: 18),

        // ====================================================
        // SIGNATURE
        // ====================================================
        pw.Row(
          mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
          children: [
            _signature('Supplier Signature', regularFont),
            _signature('Authorized Signature', regularFont),
          ],
        ),

        pw.SizedBox(height: 14),

        pw.Center(
          child: pw.Text(
            'Thank you for your business.',
            style: pw.TextStyle(
              font: boldFont,
              fontSize: 9,
              color: PdfColors.grey700,
            ),
          ),
        ),

        pw.SizedBox(height: 8),

        // ====================================================
        // FOOTER
        // ====================================================
        pw.Container(
          padding: const pw.EdgeInsets.only(top: 5),
          decoration: const pw.BoxDecoration(
            border: pw.Border(
              top: pw.BorderSide(color: PdfColors.grey400, width: .5),
            ),
          ),
          child: pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            children: [
              if (AppBuildConfig.showDeveloperBranding)
                pw.RichText(
                  text: pw.TextSpan(
                    children: [
                      pw.TextSpan(
                        text: 'Developed by ',
                        style: pw.TextStyle(
                          font: regularFont,
                          fontSize: 8,
                          color: PdfColors.grey700,
                        ),
                      ),
                      pw.TextSpan(
                        text: 'Nexera IT BD',
                        style: pw.TextStyle(
                          font: boldFont,
                          fontSize: 8,
                          color: PdfColors.blue900,
                        ),
                      ),
                    ],
                  ),
                )
              else
                pw.SizedBox(),
              pw.Text(
                'Page 1',
                style: pw.TextStyle(
                  font: regularFont,
                  fontSize: 8,
                  color: PdfColors.grey700,
                ),
              ),
            ],
          ),
        ),
      ],
    );

    pdf.addPage(
      pw.MultiPage(
        pageFormat: PdfPageFormat.a4,
        margin: const pw.EdgeInsets.all(16),
        build: (_) => [content],
      ),
    );

    return pdf.save();
  }

  static pw.Widget _brandingImage(
    pw.MemoryImage image, {
    required double width,
  }) {
    return pw.Container(
      width: width,
      height: 58,
      alignment: pw.Alignment.center,
      child: pw.Image(image, fit: pw.BoxFit.contain),
    );
  }

  static pw.Widget _labelValue(
    String label,
    String value,
    pw.Font regular,
    pw.Font bold,
  ) {
    return pw.Column(
      crossAxisAlignment: pw.CrossAxisAlignment.start,
      children: [
        pw.Text(label, style: pw.TextStyle(font: bold, fontSize: 8)),
        pw.Text(value, style: pw.TextStyle(font: regular, fontSize: 8)),
      ],
    );
  }

  static pw.Widget _infoBox({
    required String title,
    required pw.Font font,
    required pw.Font boldFont,
    required List<String> children,
  }) {
    return pw.Container(
      padding: const pw.EdgeInsets.all(10),
      decoration: pw.BoxDecoration(
        border: pw.Border.all(color: PdfColors.grey300, width: .7),
        borderRadius: pw.BorderRadius.circular(6),
      ),
      child: pw.Column(
        crossAxisAlignment: pw.CrossAxisAlignment.start,
        children: [
          pw.Text(
            title,
            style: pw.TextStyle(
              font: boldFont,
              fontSize: 9,
              color: PdfColors.blue900,
            ),
          ),
          pw.SizedBox(height: 5),
          ...children.map(
            (text) => pw.Padding(
              padding: const pw.EdgeInsets.only(bottom: 2),
              child: pw.Text(
                text,
                style: pw.TextStyle(font: font, fontSize: 9),
              ),
            ),
          ),
        ],
      ),
    );
  }

  static pw.Widget _moneyRow(
    String label,
    String value,
    pw.Font regular,
    pw.Font bold, {
    bool strong = false,
  }) {
    return pw.Padding(
      padding: const pw.EdgeInsets.symmetric(vertical: 2),
      child: pw.Row(
        children: [
          pw.Expanded(
            child: pw.Text(
              label,
              style: pw.TextStyle(font: strong ? bold : regular, fontSize: 9),
            ),
          ),
          pw.Text(
            value,
            style: pw.TextStyle(font: strong ? bold : regular, fontSize: 9),
          ),
        ],
      ),
    );
  }

  static pw.Widget _tableCell(
    String text,
    pw.Font font, {
    bool header = false,
    bool left = false,
  }) {
    return pw.Container(
      alignment: left ? pw.Alignment.centerLeft : pw.Alignment.center,
      padding: const pw.EdgeInsets.symmetric(horizontal: 5, vertical: 7),
      child: pw.Text(
        text,
        textAlign: left ? pw.TextAlign.left : pw.TextAlign.center,
        style: pw.TextStyle(
          font: font,
          fontSize: 9,
          color: header ? PdfColors.white : PdfColors.black,
        ),
      ),
    );
  }

  static pw.Widget _signature(String label, pw.Font font) {
    return pw.Container(
      width: 150,
      padding: const pw.EdgeInsets.only(top: 5),
      decoration: const pw.BoxDecoration(
        border: pw.Border(
          top: pw.BorderSide(color: PdfColors.grey500, width: .6),
        ),
      ),
      child: pw.Text(
        label,
        textAlign: pw.TextAlign.center,
        style: pw.TextStyle(font: font, fontSize: 8),
      ),
    );
  }

  static Future<void> preview({
    required Purchase purchase,
    required List<PurchaseItemHistory> items,
  }) async {
    final bytes = await generate(purchase: purchase, items: items);

    await Printing.layoutPdf(
      onLayout: (_) async => bytes,
      name: 'Purchase_${purchase.invoiceNo ?? purchase.id}.pdf',
    );
  }

  static Future<File> savePdf({
    required Purchase purchase,
    required List<PurchaseItemHistory> items,
  }) async {
    final bytes = await generate(purchase: purchase, items: items);

    final selected = await _storageService.getInvoiceFolder();

    Directory directory;

    if (selected != null &&
        selected.trim().isNotEmpty &&
        await Directory(selected).exists()) {
      directory = Directory(selected);
    } else {
      directory = await getApplicationDocumentsDirectory();
    }

    final invoiceNo = purchase.invoiceNo?.trim().isNotEmpty == true
        ? purchase.invoiceNo!.trim()
        : purchase.id?.toString() ?? 'unknown';

    final file = File(p.join(directory.path, 'Purchase_$invoiceNo.pdf'));

    await file.writeAsBytes(bytes, flush: true);

    return file;
  }
}
